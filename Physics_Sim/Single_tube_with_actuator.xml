<mujoco model = "Double Panel">
    <option timestep = "0.002" gravity = "0 0 -9.81"/>
<worldbody>
    <light pos ='0 5 5' dir = '0 -1 -1'/>
    <geom name = 'floor' type = 'plane' size = '5 5 1' rgba = '0.9 0.9 0.9 1'/>

    <body name = 'panel0' pos = '0 0 .01'>
        <!-- <freejoint/> -->
        <geom type = 'box' size = '0.5 3 0.01' rgba = '0 0 1 1' mass = '1'/>

        <body name = 'panel1' pos = '0.51 0 .51'>
            <joint type = 'hinge' axis = '0 1 0' pos = '-0.01 0 -0.5'/>
            <geom type = 'box' size = '0.01 3 0.5' rgba = '0 1 0 1' mass = '1'/>
        </body>
        <body name = 'panel2' pos = '-0.51 0 0.51'>
            <joint name = "actuation_joint" type = 'hinge' axis = '0 1 0' pos = '0.01 0 -0.5'/>
            <geom type = 'box' size = '0.01 3 0.5' rgba = '1 0 1 1' mass = '1'/>
        
            <body name = 'panel3' pos = '0.51 0 0.51'>
                <geom type = 'box' size = '0.5 3 0.01' rgba = '1 1 1 1' mass = '1'/>
                <joint type = 'hinge' axis = '0 1 0' pos = '-0.5 0 -0.01'/>
            </body>
        </body>
    </body>
</worldbody>
<!-- 
