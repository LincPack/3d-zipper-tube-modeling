  <connect name="close_loop" body1="panel3" body2="panel1" anchor="0.5 0 0"/>
</equality> -->

<equality>
    <connect name = "close_loop" body1 = "panel3" body2 = "panel1" anchor = '0.51 0 0'/>
</equality>

<actuator>
        <position name="servo_actuation" joint="actuation_joint" kp="200" kv= "10" ctrlrange="0 1.57" ctrllimited="true"/>
</actuator>

</mujoco>
<!-- The axis is kind of like the orientation of the hinge -->
